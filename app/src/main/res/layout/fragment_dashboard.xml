<?xml version="1.0" encoding="utf-8"?>
<!-- ALUMIPRO — Dashboard fragment · Industrial premium -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ap_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ HERO PANEL: dark con rejilla y bienvenida ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ap_base_2"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="28dp">

            <!-- Badge "Sistema activo" -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/ap_flame_alpha"
                app:cardCornerRadius="4dp"
                app:strokeColor="@color/ap_flame"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="● SISTEMA OPERATIVO"
                    android:textColor="@color/ap_flame_2"
                    android:textSize="9sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Saludo del usuario -->
            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-condensed"
                android:textAllCaps="true" />

            <!-- Rol y correo -->
            <TextView
                android:id="@+id/tvRolCorreo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ap_text_on_dark_muted"
                android:textSize="13sp" />

            <!-- Info API -->
            <TextView
                android:id="@+id/tvApiInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ap_text_on_dark_muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Línea separadora flame -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/bg_toolbar_flame_line" />

        <!-- ═══ STATS 2x2 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="20dp">

            <!-- Fila 1: Clientes | Productos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <!-- Card Clientes -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/ap_card"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/ap_border"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <!-- Barra superior primaria -->
                        <View android:layout_width="30dp" android:layout_height="2dp"
                            android:background="@color/ap_base_3" android:layout_marginBottom="10dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CLIENTES"
                            android:textColor="@color/ap_text_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.10"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvCountClientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/ap_text"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registrados"
                            android:textColor="@color/ap_text_muted"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Productos -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/ap_card"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/ap_border"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <View android:layout_width="30dp" android:layout_height="2dp"
                            android:background="@color/ap_base_3" android:layout_marginBottom="10dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRODUCTOS"
                            android:textColor="@color/ap_text_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.10"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvCountProductos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/ap_text"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="En inventario"
                            android:textColor="@color/ap_text_muted"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Card Ventas (full width con acento flame) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/ap_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/ap_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <!-- Barra flame -->
                    <View android:layout_width="40dp" android:layout_height="2dp"
                        android:background="@color/ap_flame" android:layout_marginBottom="10dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VENTAS REGISTRADAS"
                                android:textColor="@color/ap_text_muted"
                                android:textSize="9sp"
                                android:letterSpacing="0.10"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvCountVentas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="@color/ap_flame"
                                android:textSize="40sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSyncDashboard"
                            style="@style/Widget.Alumipro.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Sincronizar"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvUltimaSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ap_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card empresa / about -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/ap_base_2"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/ap_base_4"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALUMIPRO S.A.S."
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:fontFamily="sans-serif-condensed"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fabricación y comercialización de perfiles de aluminio, ventanería arquitectónica, fachadas y estructuras metálicas para la construcción en Colombia."
                        android:textColor="@color/ap_text_on_dark_muted"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
