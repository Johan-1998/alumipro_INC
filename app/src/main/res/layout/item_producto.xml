<?xml version="1.0" encoding="utf-8"?>
<!-- ALUMIPRO — Item Producto · ImageButton mantenido para compatibilidad con ProductoAdapter.java -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="@color/ap_card"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/ap_border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Datos del producto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/ap_text"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/tvProductoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/ap_text_muted"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Precio -->
                <TextView
                    android:id="@+id/tvProductoPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/ap_flame"
                    android:fontFamily="sans-serif-condensed" />

                <!-- Chip stock: separado con marginStart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/ap_surface"
                    app:cardCornerRadius="4dp"
                    app:strokeColor="@color/ap_border"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:id="@+id/tvProductoStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/ap_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- ImageButton: tipo requerido por ProductoAdapter.java -->
        <ImageButton
            android:id="@+id/btnEditProducto"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:padding="7dp"
            android:src="@drawable/ic_edit_24"
            android:contentDescription="Editar producto" />

        <ImageButton
            android:id="@+id/btnDeleteProducto"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:background="@android:color/transparent"
            android:padding="7dp"
            android:src="@drawable/ic_delete_24"
            android:contentDescription="Eliminar producto" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
