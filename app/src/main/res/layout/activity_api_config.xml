<?xml version="1.0" encoding="utf-8"?>
<!-- ALUMIPRO — Config API · Rediseño industrial -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ap_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ap_base"
        android:minHeight="?attr/actionBarSize"
        android:title="@string/configurar_api"
        android:titleTextColor="@color/ap_text_on_dark" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_toolbar_flame_line" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ap_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/ap_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Barra flame -->
                    <View
                        android:layout_width="36dp"
                        android:layout_height="2dp"
                        android:background="@color/ap_flame"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERVIDOR API"
                        android:textColor="@color/ap_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:fontFamily="sans-serif-condensed"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Define la URL base del backend. Para emulador usa 10.0.2.2. Para dispositivo físico usa la IP local de tu equipo."
                        android:textColor="@color/ap_text_muted"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5"
                        android:layout_marginBottom="18dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="URL base API"
                        style="@style/Widget.Alumipro.TextInputLayout"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiBaseUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="http://192.168.1.10:8080/"
                            android:inputType="textUri"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarApi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/guardar_url"
                        android:textStyle="bold"
                        app:backgroundTint="@color/ap_flame"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestablecerApi"
                        style="@style/Widget.Alumipro.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/restablecer_url" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
