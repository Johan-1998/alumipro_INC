<?xml version="1.0" encoding="utf-8"?>
<!-- ALUMIPRO — Item Venta · Rediseño industrial -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="@color/ap_card"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/ap_border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: cliente + número venta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvVentaCliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/ap_text"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.01" />

            <!-- Badge: naranja flame -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ap_flame_alpha"
                app:cardCornerRadius="4dp"
                app:strokeColor="@color/ap_flame"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/tvVentaNumero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="VENTA"
                    android:textColor="@color/ap_flame"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ap_border"
            android:layout_marginBottom="8dp" />

        <!-- Meta: fecha y datos -->
        <TextView
            android:id="@+id/tvVentaMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ap_text_muted"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Total: destacado en flame -->
        <TextView
            android:id="@+id/tvVentaTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/ap_flame"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
