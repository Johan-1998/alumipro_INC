<?xml version="1.0" encoding="utf-8"?>
<!-- ALUMIPRO — Login · Rediseño industrial premium -->
<!-- Fondo: foto de trabajadores de ventanería (se carga vía Glide/Picasso en LoginActivity.kt) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ap_base">

    <!-- Foto de fondo: trabajadores de ventanería de aluminio
         INSTRUCCIÓN DE INTEGRACIÓN: En LoginActivity.kt, cargar con Glide:
         Glide.with(this).load("https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=75")
              .centerCrop().into(ivLoginBackground)
    -->
    <ImageView
        android:id="@+id/ivLoginBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Trabajadores de aluminio y ventanería"
        android:alpha="0.22" />

    <!-- Gradiente overlay sobre la foto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_gradient" />

    <!-- Contenido principal centrado -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- LOGO + MARCA -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="36dp">

                <!-- Logo mark: rectángulo oscuro con borde flame -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardBackgroundColor="@color/ap_base_3"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/ap_flame"
                        app:strokeWidth="1.5dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="@color/ap_flame"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Nombre marca -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALUMIPRO"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-condensed" />

                <!-- Tagline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Aluminio · Ventanería · Estructuras"
                    android:textColor="@color/ap_text_on_dark_muted"
                    android:textSize="12sp"
                    android:letterSpacing="0.06" />

                <!-- Badge "Sistema activo" -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/ap_flame_alpha"
                    app:cardCornerRadius="4dp"
                    app:strokeColor="@color/ap_flame"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="● SISTEMA ACTIVO"
                        android:textColor="@color/ap_flame_2"
                        android:textSize="10sp"
                        android:letterSpacing="0.10"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CARD DE FORMULARIO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ap_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/ap_border"
                app:strokeWidth="1dp"
                app:cardElevation="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Barra flame superior izquierda -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@color/ap_flame"
                        android:layout_marginBottom="18dp" />

                    <!-- Título del formulario -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INGRESA AL SISTEMA"
                        android:textColor="@color/ap_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:fontFamily="sans-serif-condensed"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceso restringido a personal autorizado"
                        android:textColor="@color/ap_text_muted"
                        android:textSize="13sp"
                        android:layout_marginBottom="24dp" />

                    <!-- Campo correo -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Correo electrónico"
                        style="@style/Widget.Alumipro.TextInputLayout"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:hint="@string/correo_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contraseña"
                        style="@style/Widget.Alumipro.TextInputLayout"
                        app:endIconMode="password_toggle"
                        android:layout_marginBottom="24dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:hint="@string/password_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón ingresar: naranja flame full-width -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIngresar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="INGRESAR AL SISTEMA"
                        android:textSize="14sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold"
                        app:backgroundTint="@color/ap_flame"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Botón config API: outlined -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfigApi"
                        style="@style/Widget.Alumipro.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Configurar servidor API"
                        android:textSize="13sp"
                        android:layout_marginBottom="18dp" />

                    <!-- URL API actual -->
                    <TextView
                        android:id="@+id/tvApiActual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ap_text_muted"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="16dp" />

                    <!-- Credenciales demo -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/ap_surface"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:text="@string/credenciales_demo"
                            android:textColor="@color/ap_text_muted"
                            android:textSize="11sp"
                            android:lineSpacingMultiplier="1.5" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
